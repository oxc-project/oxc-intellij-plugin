<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="Oxc.Shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Oxc"
                           displayType="BALLOON"
                           bundle="messages.OxcFrontendBundle"
                           key="notification.group.oxc"/>
    </extensions>

    <actions resource-bundle="messages.OxcFrontendBundle">
        <action id="OxlintRestartServerAction"
                class="com.github.oxc.project.oxcintellijplugin.frontend.oxlint.OxlintRestartServerAction"/>
    </actions>
</idea-plugin>
