<idea-plugin>
    <dependencies>
        <module name="intellij.platform.backend"/>
        <module name="intellij.platform.kernel.backend"/>
        <module name="intellij.platform.rpc.backend"/>
        <module name="Oxc.Shared"/>
        <module name="intellij.javascript.backend"/>
        <plugin id="com.intellij.modules.lsp"/>
        <plugin id="com.intellij.modules.json"/>
        <plugin id="JavaScript"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <platform.rpc.backend.remoteApiProvider
                implementation="com.github.oxc.project.oxcintellijplugin.backend.rpc.OxcBackendRpcApiProvider"/>
        <registryKey key="oxc.lint.fix.all.timeout.ms"
                     defaultValue="30000"
                     description="Per-file timeout in milliseconds for computing oxlint fixes (diagnostic warm-up plus code action request). Used by 'Fix All' on save and the 'Apply Oxlint Quick Fixes' action. Values less than or equal to 0 fall back to the default."/>
        <!-- Runs before the reformat, because a reformat's didChange clears the server's cached fixes. -->
        <actionOnSave id="OxlintFixAllOnSaveAction"
                      implementation="com.github.oxc.project.oxcintellijplugin.backend.oxlint.fix.OxlintFixAllOnSaveAction"
                      order="first, before FormatOnSaveAction"/>
        <actionOnSaveInfoProvider id="OxcOnSaveInfoProvider"
                                  implementation="com.github.oxc.project.oxcintellijplugin.backend.tool.OxcOnSaveInfoProvider"
                                  order="after FormatOnSaveInfoProvider, after EsLintOnSaveInfoProvider, before FileWatcherOnSaveInfoProvider, before UploadOnSaveInfoProvider"/>
        <platform.lsp.integrationProvider
                implementation="com.github.oxc.project.oxcintellijplugin.backend.oxlint.lsp.OxlintLspIntegrationProvider"/>
    </extensions>

    <projectListeners>
        <listener class="com.github.oxc.project.oxcintellijplugin.backend.tool.ToolEditorWatcher"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
        <listener class="com.github.oxc.project.oxcintellijplugin.backend.tool.ToolSettingsWatcher"
                  topic="com.github.oxc.project.oxcintellijplugin.backend.tool.OxcSettingsListener"/>
        <listener class="com.github.oxc.project.oxcintellijplugin.backend.tool.OutsideConfigWatcher$Listener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>
</idea-plugin>
